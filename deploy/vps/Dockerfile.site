# Build Next.js (site/) + CMS admin static into one image.
FROM node:22-bookworm-slim AS deps
WORKDIR /repo
COPY site/package.json site/package-lock.json ./site/
COPY web/package.json web/package-lock.json ./web/
RUN cd site && npm ci
RUN cd web && npm ci

FROM node:22-bookworm-slim AS build
WORKDIR /repo
COPY --from=deps /repo/site/node_modules ./site/node_modules
COPY --from=deps /repo/web/node_modules ./web/node_modules
COPY site ./site
COPY web ./web
COPY package.json ./
# CMS → site/public/admin
RUN npm run build --prefix web -- --base=/admin/ --outDir ../site/public/admin --emptyOutDir
ARG API_URL=http://api:4000
ENV API_URL=$API_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN cd site && npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
COPY --from=build /repo/site/public ./public
COPY --from=build /repo/site/.next/standalone ./
COPY --from=build /repo/site/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
