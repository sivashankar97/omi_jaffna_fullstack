# Copy to deploy/vps/.env on the VPS (never commit real secrets).
# Generate passwords: openssl rand -base64 32

POSTGRES_DB=omi_jaffna
POSTGRES_USER=omi_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARS_HERE
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_12PLUS

# Production domain (HTTPS):
FRONTEND_ORIGIN=https://omijaffna.com

# false on HTTP/IP only; true with HTTPS domain
COOKIE_SECURE=true

MEDIA_STORE=postgres
FATHER_SELF_REGISTER=true
TRUST_PROXY=1

# Password reset emails (Forgot password). Required in production or reset emails are not sent.
PUBLIC_SITE_URL=https://omijaffna.com
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OMI Jaffna <no-reply@omijaffna.com>"
# Real mailbox that gets a check email every 2 weeks so Brevo keeps the SMTP key active
MAIL_KEEPALIVE_TO=
# "Write with AI" in the Father dashboard (free key from aistudio.google.com); blank = button shows "not set up"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
