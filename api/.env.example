PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://omi_admin:change-me-to-a-strong-database-password@127.0.0.1:5432/omi_jaffna
DATABASE_SSL=false
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-strong-unique-password
# Comma-separated. On VPS include https://your-domain (and www if used).
FRONTEND_ORIGIN=http://localhost:5173
# Local http: false. Production HTTPS / VPS: true (or omit — auto-secure when NODE_ENV=production).
COOKIE_SECURE=false
# Father self-register: omit/true = open (accounts stay inactive until admin activates). false = closed.
# FATHER_SELF_REGISTER=true
# Behind nginx/Caddy on VPS:
# TRUST_PROXY=1
# Local / VPS: postgres (bytes in media_blobs table) or disk (api/uploads).
# Cloud: MEDIA_STORE=supabase + SUPABASE_* keys.
MEDIA_STORE=postgres
UPLOAD_DIR=./uploads
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-from-dashboard
# SUPABASE_STORAGE_BUCKET=media

# Password reset emails (Forgot password). Without SMTP_HOST, development prints the link in the API log.
PUBLIC_SITE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OMI Jaffna <no-reply@example.org>"
# Real mailbox that gets a check email every 2 weeks so Brevo keeps the SMTP key active
MAIL_KEEPALIVE_TO=
