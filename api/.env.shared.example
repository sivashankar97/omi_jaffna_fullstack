# Local Mac development against the VPS Postgres (shared by 2 people).
# 1) Terminal A:  npm run db:tunnel -- user@VPS_IP
# 2) Copy this file to api/.env  (or merge these keys into your api/.env)
# 3) Terminal B:  npm run dev
#
# MEDIA_STORE=postgres keeps uploads in the shared DB (both Macs see the same files).

PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Tunnel port (db-tunnel.sh default 5433)
DATABASE_URL=postgres://omi_admin:SAME_PASSWORD_AS_VPS@127.0.0.1:5433/omi_jaffna
DATABASE_SSL=false

JWT_SECRET=SAME_JWT_SECRET_AS_VPS_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=use-cms-login-not-needed-for-dev

# Browser talks to localhost site; API is proxied by Next rewrite
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

MEDIA_STORE=postgres
TRUST_PROXY=0
FATHER_SELF_REGISTER=true
